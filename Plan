## 3. Database Schema (Postgres, all in `public`, RLS-enabled, workspace-scoped)

```text
profiles(id PK = auth.users.id, full_name, avatar_url, created_at)

workspaces(id PK, owner_id FK→profiles, name, business_dna jsonb, primary_goal text,
           goal_object jsonb, plan_tier enum['solo','full'], trial_ends_at, stripe_customer_id)

workspace_members(workspace_id FK, user_id FK, role enum['owner','editor','viewer'], PK(ws,user))

user_roles(id PK, user_id FK, role app_role)   -- security-definer has_role()

assets(id PK, workspace_id FK, uploaded_by, kind enum['pdf','pptx','docx','image','csv'],
       storage_path, extracted_text, extracted_meta jsonb, created_at)

integrations(id PK, workspace_id FK, provider enum['ga4','gsc','meta_ads','linkedin','tiktok'],
             status enum['connected','pending','error'], oauth_tokens jsonb [encrypted], scopes)

past_attempts(id PK, workspace_id FK, channel, summary text, outcome_tag, spend_usd, created_at)

agents(id PK, workspace_id FK, agent_type enum['cmo','seo','smm','bdm','design','data'],
       enabled bool, system_prompt jsonb, memory_store jsonb, created_at)

truth_reports(id PK, workspace_id FK, generated_at, status, loopholes jsonb
              -- [{id, severity, title, evidence, proposed_fix, approved bool}])

strategy_plans(id PK, workspace_id FK, version, plan jsonb, active bool, created_at)

tasks(id PK, workspace_id FK, plan_id FK, assigned_agent enum, title, brief jsonb,
      status enum['queued','running','qc','approval','approved','rejected','live','failed'],
      output jsonb, qc_notes, created_at, updated_at)

approvals(id PK, task_id FK, decided_by, decision enum['approve','reject'], note, decided_at)

critique_events(id PK, workspace_id FK, user_request text, conflict_type enum['goal','data','history'],
                cmo_alternative text, evidence jsonb, user_choice enum['accepted','overridden'], created_at)

action_log(id PK, workspace_id FK, actor enum['user','cmo','agent','system'], actor_id,
           action text, payload jsonb, created_at)   -- append-only

job_queue(id PK, workspace_id FK, job_type, payload jsonb, status, attempts, run_after, result jsonb)

subscriptions(id PK, workspace_id FK, stripe_sub_id, tier, addons jsonb, status, current_period_end)
```

**RLS pattern:** every table has `workspace_id`; policy = `workspace_id IN (SELECT workspace_id FROM workspace_members WHERE user_id = auth.uid())`. `user_roles` checked via `public.has_role()` security-definer fn.

