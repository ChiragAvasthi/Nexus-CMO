// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String      @id @default(uuid())
  email         String      @unique
  password_hash String?
  googleId      String?     @unique
  name          String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  workspaces    Workspace[]
}

model Workspace {
  id              String   @id @default(uuid())
  name            String
  companyName     String?
  industry        String?
  ownerId         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  owner           User      @relation(fields: [ownerId], references: [id])
  products        Product[]
  assets          Asset[]
  tasks           Task[]
  messages        Message[]
  integrations    Integration[]
}

model Product {
  id              String   @id @default(uuid())
  workspaceId     String
  name            String
  targetAudience  String?
  currentProblem  String?
  goal            String?
  budget          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  assets          Asset[]
  tasks           Task[]
  messages        Message[]
}

model Asset {
  id          String    @id @default(uuid())
  title       String
  type        String
  status      String
  content     String    @default("")
  agentId     String    @default("system")
  taskId      String?
  workspaceId String
  productId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  product     Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Task {
  id          String    @id @default(uuid())
  agentId     String
  status      String
  description String
  workspaceId String
  productId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  product     Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Message {
  id          String    @id @default(uuid())
  workspaceId String
  productId   String?
  agentId     String    @default("cmo")
  sender      String
  content     String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  product     Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Integration {
  id          String    @id @default(uuid())
  workspaceId String
  provider    String    // e.g., 'google_analytics', 'search_console', 'meta_ads', 'linkedin'
  status      String    // e.g., 'connected'
  connectedAt DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  
  @@unique([workspaceId, provider])
}
